# =============================================================================
# Chobbar Shop API — environment (read with django-environ from this file or the
# real environment). Copy to `.env`:   cp .env.example .env
#
# With Docker (`make up`) the DATABASE_URL / REDIS_URL / CELERY / CHANNEL / EMAIL_HOST
# values are overridden automatically to point at the containers, so the localhost
# values below are right for running Django from a virtualenv too.
# =============================================================================

# --- Core Django --------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development   # config.settings.production on servers
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
JWT_SIGNING_KEY=another-long-random-string-used-only-to-sign-jwts
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
SITE_NAME=Chobbar
FRONTEND_URL=http://localhost:3000            # used in emails and redirects
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True                   # development only
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_CURRENCY=PKR
ADMIN_URL=admin/                              # production: use an unguessable path, e.g. ops-7f3k/

# --- Database (PostgreSQL 16 required) ----------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/chobbar
DB_CONN_MAX_AGE=60
# Used by docker-compose for the Postgres container and host port mapping
POSTGRES_DB=chobbar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Redis: cache / Celery broker / Channels layer -----------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2
REDIS_PORT=6379                               # docker-compose host port
CELERY_TASK_ALWAYS_EAGER=True                 # venv dev: run tasks inline (Docker sets False, worker container runs them)

# --- Auth ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=                       # Google Cloud OAuth "Web application" client id (same as the frontend's)

# --- Email --------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend   # Docker overrides to SMTP → Mailpit UI at :8025
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Chobbar <no-reply@chobbar.shop>
SUPPORT_EMAIL=support@chobbar.shop
SUPPORT_PHONE=+92 300 0000000
STORE_ADDRESS=Sialkot, Punjab, Pakistan
ADMIN_NOTIFICATION_EMAILS=admin@chobbar.shop  # comma-separated; staff alerts for orders, quotes, payments

# --- Docker / Makefile conveniences --------------------------------------------
API_PORT=8000
MAILPIT_PORT=8025
SEED_ON_START=0                               # 1 = seed demo catalog & users when the api container starts

# --- Production-only (ignored in development) ---------------------------------
SECURE_SSL_REDIRECT=True
