# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SIGNING_KEY=another-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Leepa Sports
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_CURRENCY=USD

# --- Data stores ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/leepasports
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=True

# --- Auth ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Leepa Sports <no-reply@leepasports.com>
SUPPORT_EMAIL=sales@leepasports.com
ADMIN_NOTIFICATION_EMAILS=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
